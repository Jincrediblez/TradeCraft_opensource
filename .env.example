# Optional AI summaries. Deterministic audit features work without these.
KIMI_API_KEY=
KIMI_API_URL=https://api.moonshot.cn/v1/chat/completions
KIMI_MODEL=moonshot-v1-32k

# Optional path to a performance workbook. The default is
# data/inbox/收益曲线.xlsx.
TRADECRAFT_PERFORMANCE_FILE=

# Optional server and market-data tuning.
PORT=8787
YAHOO_TIMEOUT_SECONDS=20
YAHOO_ERROR_RETRY_SECONDS=900
